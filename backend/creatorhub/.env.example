# Local development only. Copy to .env and replace the password; never commit .env.
DATABASE_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/creatorhub
DATABASE_PORT=5433
DATABASE_USERNAME=creatorhub
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@creatorhub.local
# Assessment/demo only. Default false; never enable for real identity approval.
DEMO_VERIFICATION_ENABLED=false
# Production STARTTLS SMTP: set SMTP_USERNAME, SMTP_PASSWORD, SMTP_AUTH=true,
# SMTP_STARTTLS=true and the provider host/port through deployment secrets.
# Generate APP_JWT_SECRET in your shell; see docs/authentication.md.
# Never commit the generated value. Spring Boot does not automatically read .env.
